# ── SearXNG Keyword Search (Stage 0) ──────────────────────────────────────────
# SearXNG must be running via Docker (docker-compose up -d)
SEARXNG_BASE_URL=http://127.0.0.1:8080
SEARXNG_MAX_PAGES=4        # Pages to fetch per keyword (10 results/page)
SEARXNG_PAGE_DELAY=1.0     # Seconds between pages (be polite to search engines)
SEARXNG_TIMEOUT=10.0       # HTTP request timeout in seconds

# ── MongoDB Configuration ──────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=gamblingsites
MONGO_COLLECTION=domain_Listed          # Stage 1 output / Stage 2 source
CHECKED_COLLECTION=checked_domains      # Stage 2/3 output
# MONGOD_AUTOSTART_PATH=C:\Program Files\MongoDB\Server\8.0\bin\mongod.exe
# MONGOD_AUTOSTART_CFG=C:\Program Files\MongoDB\Server\8.0\bin\mongod.cfg


# ── Stage 1 — Common Crawl Fetch Tuning ───────────────────────────────────────
MAX_WORKERS=200
TIMEOUT=5.0
MONGO_BATCH_SIZE=1000
PARQUET_BATCH_SIZE=20
EXPORT_TO_MONGO=true

# ── Stage 2 — Checking URL & Classification Tuning ─────────────────────────────
FETCH_TIMEOUT=10
PER_DOMAIN_DELAY=2.0
MAX_CONCURRENT_FETCHES=20

# ── Deep Crawl Link Extraction ────────────────────────────────────────────────
# Extract external links from aggregator gambling sites and queue for Stage 2
DEEP_CRAWL_MIN_LINKS=3                  # Min outbound links to consider page an aggregator
DEEP_CRAWL_STRICT=false                 # true = only keep links matching gambling keywords

# ── Stage 3 — Playwright Screenshot Tuning ─────────────────────────────────────
SCREENSHOT_CONCURRENCY=15


# ── Stage 4 — Export Batch Tuning ──────────────────────────────────────────────
# Number of domains per batch when exporting Word (.docx) and Excel (.xlsx) files.
# Each batch gets its own subfolder: output/<timestamp>/batch_001/, batch_002/, ...
EXPORT_BATCH_SIZE=40

# ── Local AI Intelligence Classifier (Ollama, custom models built from qwen2.5:3b) ──
ENABLE_AI_CLASSIFIER=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gambling-analyst           # built via: ollama create gambling-analyst -f Modelfile
OLLAMA_VALIDATOR_MODEL=gambling-validator  # built via: ollama create gambling-validator -f Modelfile.validator
                              # Must be a DIFFERENT model from OLLAMA_MODEL — the Validator's
                              # value is that it's an independent adversarial second opinion.
                              # (Fixed 2026-08-21: production .env had this equal to OLLAMA_MODEL
                              # with gambling-validator never built, so every "validator" round
                              # was really the Analyst re-confirming itself. Run `ollama list` to
                              # confirm both models exist before trusting classification output.)
                              # As of 2026-08-24, ai_classifier.py refuses to import if this
                              # equals OLLAMA_MODEL, so this can no longer regress silently.
# ALLOW_SAME_OLLAMA_VALIDATOR_MODEL=true   # escape hatch for deliberate single-model local testing only
OLLAMA_TIEBREAKER_MODEL=qwen2.5:7b-instruct-q4_K_M   # third opinion, only invoked when the
                              # Validator returns "uncertain" or both Validator attempts fail —
                              # a tiny slice of total volume, so a bigger model is affordable
                              # here. Pull with: ollama pull qwen2.5:7b-instruct-q4_K_M
                              # (~4.5GB q4 — safe alongside the 3B analyst/validator on 16GB RAM;
                              # set OLLAMA_MAX_LOADED_MODELS=1 on the Ollama server if you ever
                              # bump this to a 14B+ model, so it evicts the previous model
                              # instead of trying to hold two large models resident at once)
OLLAMA_VISION_MODEL=moondream  # last-resort screenshot classifier for canvas/WebGL-rendered
                              # casino UIs (slot reels, live dealer feeds) that ship zero DOM
                              # text and zero OCR-readable banner text — nothing else in the
                              # pipeline can see these. Purpose-built small vision model
                              # (~1.7GB), not a general VLM. Pull with: ollama pull moondream
AI_MODE=hybrid               # hybrid (borderline only) | all (every page) | off
AI_FAST_MODE=false           # Skip Round-2 "prove regular" challenge for high-confidence,
                              # non-anchored regular verdicts. Keep this false — a false positive
                              # (banning a legitimate site) is far more expensive here than the
                              # extra Ollama calls this costs. (Fixed 2026-08-21: production .env
                              # had this set to true GLOBALLY — not just for recheck modes as the
                              # code comments imply — so every run, not only rechecks, gave
                              # "regular" verdicts less scrutiny than "gambling" verdicts.)
AI_TIMEOUT=15.0              # seconds per Ollama inference request
AI_CONCURRENCY=10            # maximum parallel AI inferences (raised from 5 — was far below
                              # MAX_CONCURRENT_FETCHES=20, causing routine timeouts under
                              # batch load; tune based on what your Ollama host can sustain)

# ── Non-English Page Translation (Optional) ──────────────────────────────────
# Since gambling-analyst (built on qwen2.5:3b) natively understands foreign languages
# (Spanish, Russian, Arabic, Portuguese, Vietnamese, etc.), pre-translation is disabled
# by default (empty) to avoid Ollama model-swapping latency and timeouts. Set to a model
# name (e.g. qwen2.5:3b) only if you specifically require pre-translation.
TRANSLATE_MODEL=
TRANSLATE_TIMEOUT=45.0
