# ── Stage 0 — Crawlee Keyword & Hub Discovery (No Docker Required) ─────────────
USE_CRAWLEE=true
CRAWLEE_CONCURRENCY=10
CRAWLEE_HEADLESS=true
PAGE_DELAY_SECONDS=1.5
REQUEST_TIMEOUT=15.0
EMPTY_PAGE_TOLERANCE=3
SAVE_EVERY_N_DOMAINS=30
LIVE_CHECK_CONCURRENCY=50
LIVE_CHECK_TIMEOUT=8.0
# ── MongoDB Configuration ──────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=gamblingsitetry
MONGO_COLLECTION=domain_Listed          # Stage 1 output / Stage 2 source
CHECKED_COLLECTION=checked_domains      # Stage 2/3 output
# MONGOD_AUTOSTART_PATH=C:\Program Files\MongoDB\Server\8.0\bin\mongod.exe
# MONGOD_AUTOSTART_CFG=C:\Program Files\MongoDB\Server\8.0\bin\mongod.cfg


# ── Stage 1 — Common Crawl Fetch Tuning ───────────────────────────────────────
MAX_WORKERS=200
TIMEOUT=5.0
MONGO_BATCH_SIZE=1000
PARQUET_BATCH_SIZE=20
EXPORT_TO_MONGO=true

# ── Stage 2 — Checking URL & Classification Tuning ─────────────────────────────
FETCH_TIMEOUT=10
PER_DOMAIN_DELAY=2.0
MAX_CONCURRENT_FETCHES=20

# ── Deep Crawl Link Extraction ────────────────────────────────────────────────
# Extract external links from aggregator gambling sites and queue for Stage 2
DEEP_CRAWL_MIN_LINKS=3                  # Min outbound links to consider page an aggregator
DEEP_CRAWL_STRICT=false                 # true = only keep links matching gambling keywords

# ── Stage 3 — Playwright Screenshot Tuning ─────────────────────────────────────
SCREENSHOT_CONCURRENCY=15


# ── Stage 4 — Export Batch Tuning ──────────────────────────────────────────────
# Number of domains per batch when exporting Word (.docx) and Excel (.xlsx) files.
# Each batch gets its own subfolder: output/<timestamp>/batch_001/, batch_002/, ...
EXPORT_BATCH_SIZE=40

# ── OmniRoute Cloud AI Gateway (150+ Free Tiers / ~1.5B Free Tokens/Mo) ────────
ENABLE_AI_CLASSIFIER=true
USE_CRAWL4AI_FOR_AI=true         # Convert candidate pages into clean token-efficient Markdown for AI
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=your_omniroute_api_key_here
OMNIROUTE_MODEL=auto             # Zero-config smart routing across 150+ free models
OMNIROUTE_VALIDATOR_MODEL=auto   # Independent adversarial second opinion
OMNIROUTE_TIEBREAKER_MODEL=auto  # Third opinion for disputed verdicts
OMNIROUTE_VISION_MODEL=auto      # Vision classifier for screenshot verification
AI_MODE=hybrid                   # hybrid (borderline only) | all (every page) | off
AI_FAST_MODE=false               # Skip Round-2 "prove regular" challenge for high-confidence regular
AI_TIMEOUT=25.0                  # seconds per OmniRoute inference request
AI_CONCURRENCY=8                 # maximum parallel AI inferences

# ── Non-English Page Translation (Optional) ──────────────────────────────────
TRANSLATE_MODEL=
TRANSLATE_TIMEOUT=30.0
