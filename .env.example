# ── MongoDB Configuration ──────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=gamblingsites
MONGO_COLLECTION=domain_Listed          # Stage 1 output / Stage 2 source
CHECKED_COLLECTION=checked_domains      # Stage 2/3 output
KEYWORDS_COLLECTION=keywords            # Signal terms collection

# ── Stage 1 — Common Crawl Fetch Tuning ───────────────────────────────────────
MAX_WORKERS=200
TIMEOUT=5.0
MONGO_BATCH_SIZE=1000
PARQUET_BATCH_SIZE=20
EXPORT_TO_MONGO=true

# ── Stage 2 — Checking URL & Classification Tuning ─────────────────────────────
FETCH_TIMEOUT=10
PER_DOMAIN_DELAY=2.0
MAX_CONCURRENT_FETCHES=20

# Scrapling stealth escalation: when a domain fails the fast (curl_cffi) tier
# with a "blocked" verdict (403/429/Cloudflare challenge markers), retry it
# once with a real stealth browser that solves Cloudflare Turnstile/Interstitial
# challenges instead of just detecting them. Off by default because it's much
# slower/heavier per-domain than the fast tier.
STEALTH_FALLBACK=false
STEALTH_TIMEOUT=60
STEALTH_CONCURRENCY=3

# ── Stage 3 — Playwright Screenshot Tuning ─────────────────────────────────────
SCREENSHOT_CONCURRENCY=15
