# ── SearXNG Keyword Search (Stage 0) ──────────────────────────────────────────
# SearXNG must be running via Docker (docker-compose up -d)
SEARXNG_BASE_URL=http://127.0.0.1:8080
SEARXNG_MAX_PAGES=4        # Pages to fetch per keyword (10 results/page)
SEARXNG_PAGE_DELAY=1.0     # Seconds between pages (be polite to search engines)
SEARXNG_TIMEOUT=10.0       # HTTP request timeout in seconds

# ── MongoDB Configuration ──────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=gamblingsites
MONGO_DB2_NAME=gamblingsitetry              # Secondary database for comparison scripts
MONGO_COLLECTION=domain_Listed          # Stage 1 output / Stage 2 source
CHECKED_COLLECTION=checked_domains      # Stage 2/3 output


# ── Stage 1 — Common Crawl Fetch Tuning ───────────────────────────────────────
MAX_WORKERS=200
TIMEOUT=5.0
MONGO_BATCH_SIZE=1000
PARQUET_BATCH_SIZE=20
EXPORT_TO_MONGO=true

# ── Stage 2 — Checking URL & Classification Tuning ─────────────────────────────
FETCH_TIMEOUT=10
PER_DOMAIN_DELAY=2.0
MAX_CONCURRENT_FETCHES=20

# Scrapling stealth escalation: when a domain fails the fast (curl_cffi) tier
# with a "blocked" verdict (403/429/Cloudflare challenge markers), retry it
# once with a real stealth browser that solves Cloudflare Turnstile/Interstitial
# challenges instead of just detecting them. Off by default because it's much
# slower/heavier per-domain than the fast tier.
STEALTH_FALLBACK=false
STEALTH_TIMEOUT=60
STEALTH_CONCURRENCY=3

# ── Deep Crawl Link Extraction ────────────────────────────────────────────────
# Extract external links from aggregator gambling sites and queue for Stage 2
DEEP_CRAWL_MIN_LINKS=3                  # Min outbound links to consider page an aggregator
DEEP_CRAWL_STRICT=false                 # true = only keep links matching gambling keywords

# ── Stage 3 — Playwright Screenshot Tuning ─────────────────────────────────────
SCREENSHOT_CONCURRENCY=15


# ── Stage 4 — Export Batch Tuning ──────────────────────────────────────────────
# Number of domains per batch when exporting Word (.docx) and Excel (.xlsx) files.
# Each batch gets its own subfolder: output/<timestamp>/batch_001/, batch_002/, ...
EXPORT_BATCH_SIZE=40

# ── Local AI Intelligence Classifier (Ollama + LLaMA 3.2 3B) ──────────────────
ENABLE_AI_CLASSIFIER=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gambling-analyst
AI_MODE=hybrid               # hybrid (borderline only) | all (every page) | off
AI_TIMEOUT=15.0              # seconds per Ollama inference request
AI_CONCURRENCY=5             # maximum parallel AI inferences
