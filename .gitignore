# --- Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.eggs/
build/
dist/

# --- Virtual environments ---
venv/
.venv/
env/
ENV/

# --- Presence runtime data (rebuilt by the app, never hand-edited) ---
data/
logs/
output/
*.db-journal
*.sqlite
*.sqlite3
data/presence.db

!config/
# ^ remove the line above if you never keep a tracked CSV in config/


# --- Config secrets (keep settings.yaml tracked, but not any env/secret file) ---
.env
.env.*
!.env.example
*.secret.yaml
config/settings.local.yaml

# --- Docker / SearXNG runtime state ---
searxng/data/
searxng/uwsgi.ini
docker-volumes/

# --- Editors / OS cruft ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Logs (redundant with logs/ above, kept explicit for safety) ---
*.log

# --- Temp / scratch files agents sometimes leave behind ---
*.tmp
*_test_output*
spec_audit*.md
*.zip
